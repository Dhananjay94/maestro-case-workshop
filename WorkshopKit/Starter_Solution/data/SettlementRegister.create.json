{
  "displayName": "SettlementRegister",
  "description": "Internal simulation of settlement and payment processing for the motor insurance workshop.",
  "fields": [
    {
      "name": "ClaimId",
      "type": "STRING",
      "description": "Business claim identifier being settled.",
      "isRequired": true,
      "isUnique": true,
      "lengthLimit": 200
    },
    {
      "name": "CustomerName",
      "type": "STRING",
      "description": "Customer name.",
      "isRequired": true,
      "lengthLimit": 200
    },
    {
      "name": "PolicyNumber",
      "type": "STRING",
      "description": "Policy number.",
      "isRequired": true,
      "lengthLimit": 200
    },
    {
      "name": "SettlementAmount",
      "type": "DECIMAL",
      "description": "Final settlement amount.",
      "isRequired": true,
      "decimalPrecision": 2
    },
    {
      "name": "ApprovalStatus",
      "type": "STRING",
      "description": "Settlement approval state.",
      "isRequired": true,
      "lengthLimit": 50
    },
    {
      "name": "SettlementStatus",
      "type": "STRING",
      "description": "Payment processing state.",
      "isRequired": true,
      "lengthLimit": 50
    },
    {
      "name": "PaymentReference",
      "type": "STRING",
      "description": "Simulated payment reference.",
      "lengthLimit": 200
    },
    {
      "name": "SettlementDate",
      "type": "DATE",
      "description": "Date payment was processed."
    }
  ]
}