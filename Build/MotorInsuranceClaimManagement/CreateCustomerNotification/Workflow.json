{
  "document": {
    "dsl": "1.0.0",
    "name": "CreateCustomerNotification",
    "tags": {
      "projectId": "6870eeef-499e-414a-99fb-ae95a4697479"
    },
    "version": "0.0.1",
    "namespace": "default",
    "metadata": {
      "variables": []
    }
  },
  "do": [
    {
      "Sequence_1": {
        "do": [
          {
            "WorkflowStart": {
              "set": "${ { ...Object.entries($workflow.definition?.document?.metadata?.variables?.schema?.document?.properties || {}).reduce((acc, [name, def]) => ({ ...acc, [name]: def?.default }), {}), ...($workflow.input || {}) } }",
              "output": {
                "as": "${$input}"
              },
              "export": {
                "as": "{ ...$context, variables: { ...$context.variables, ...$output } }"
              },
              "metadata": {
                "activityType": "Assign",
                "displayName": "Workflow start",
                "fullName": "Assign",
                "isTransparent": true
              }
            }
          },
          {
            "Javascript_1": {
              "run": {
                "script": {
                  "code": "const i = $workflow.input;\nlet outcome, text;\nif (i.SettlementStatus === 'Paid') {\n  outcome = 'Settled';\n  text = 'Dear ' + i.CustomerName + ', your claim ' + i.ClaimId + ' has been settled for INR ' + i.SettlementAmount + '.';\n} else if (i.FraudInvestigationResult === 'Confirmed') {\n  outcome = 'FraudRejected';\n  text = 'Dear ' + i.CustomerName + ', after investigation your claim ' + i.ClaimId + ' cannot be accepted.';\n} else {\n  outcome = 'Denied';\n  text = 'Dear ' + i.CustomerName + ', your claim ' + i.ClaimId + ' has been declined.';\n}\nreturn { NotificationStatus: 'Prepared: ' + outcome, ClaimOutcome: outcome, NotificationText: text };",
                  "language": "javascript",
                  "arguments": "${{ \"$context\": $context, \"$workflow\": $workflow, \"$input\": $input }}"
                }
              },
              "export": {
                "as": "{ ...$context, outputs: { ...$context?.outputs, \"Javascript_1\": $output } }"
              },
              "metadata": {
                "activityType": "JsInvoke",
                "displayName": "Compute",
                "fullName": "JsInvoke"
              }
            }
          },
          {
            "Response_1": {
              "response": "${{ NotificationStatus: $context.outputs.Javascript_1.NotificationStatus, ClaimOutcome: $context.outputs.Javascript_1.ClaimOutcome, NotificationText: $context.outputs.Javascript_1.NotificationText }}",
              "markJobAsFailed": false,
              "then": "end",
              "export": {
                "as": "{ ...$context, outputs: { ...$context?.outputs, \"Response_1\": $output } }"
              },
              "metadata": {
                "activityType": "Response",
                "displayName": "Response",
                "fullName": "Response"
              }
            }
          }
        ],
        "metadata": {
          "activityType": "Sequence",
          "displayName": "Sequence",
          "fullName": "Sequence"
        }
      }
    }
  ],
  "evaluate": {
    "mode": "strict",
    "language": "javascript"
  },
  "input": {
    "schema": {
      "format": "json",
      "document": {
        "type": "object",
        "properties": {
          "ClaimId": {
            "type": "string"
          },
          "CustomerName": {
            "type": "string"
          },
          "SettlementStatus": {
            "type": "string"
          },
          "FraudInvestigationResult": {
            "type": "string"
          },
          "SettlementAmount": {
            "type": "number"
          }
        },
        "title": "Inputs"
      }
    }
  },
  "output": {
    "schema": {
      "format": "json",
      "document": {
        "type": "object",
        "properties": {
          "NotificationStatus": {
            "type": "string"
          },
          "ClaimOutcome": {
            "type": "string"
          },
          "NotificationText": {
            "type": "string"
          }
        },
        "title": "Outputs"
      }
    }
  }
}