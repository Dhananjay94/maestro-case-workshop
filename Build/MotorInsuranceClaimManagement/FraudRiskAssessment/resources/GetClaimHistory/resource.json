{
  "$resourceType": "tool",
  "name": "GetClaimHistory",
  "description": "Returns the insurer's internal claim history for a policy: number of prior claims, number of recent similar claims, last claim date, and a risk note. Always call this first with the PolicyNumber.",
  "location": "solution",
  "type": "process",
  "inputSchema": {
    "type": "object",
    "properties": {
      "PolicyNumber": {
        "type": "string",
        "description": "Policy number to look up"
      }
    },
    "required": [
      "PolicyNumber"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "PriorClaimCount": {
        "type": "number",
        "description": "Number of prior claims"
      },
      "RecentSimilarClaimCount": {
        "type": "number",
        "description": "Number of recent similar collision claims"
      },
      "LastClaimDate": {
        "type": "string",
        "description": "Date of the last prior claim, empty if none"
      },
      "HistoryRiskNote": {
        "type": "string",
        "description": "Internal note about the history"
      }
    }
  },
